{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrLogin",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "EcrPushOneRepository",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:CompleteLayerUpload",
        "ecr:GetDownloadUrlForLayer",
        "ecr:InitiateLayerUpload",
        "ecr:PutImage",
        "ecr:UploadLayerPart"
      ],
      "Resource": "${ecr_repository_arn}"
    },
    {
      "Sid": "EcsReadTaskDefinitions",
      "Effect": "Allow",
      "Action": "ecs:DescribeTaskDefinition",
      "Resource": "*"
    },
    {
      "Sid": "EcsRegisterOneFamily",
      "Effect": "Allow",
      "Action": "ecs:RegisterTaskDefinition",
      "Resource": "${task_definition_family_arn}",
      "Condition": {
        "ForAllValues:StringEquals": {
          "ecs:compute-compatibility": ["FARGATE"]
        },
        "StringEqualsIfExists": {
          "ecs:privileged": "false"
        }
      }
    },
    {
      "Sid": "EcsUpdateOneService",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeServices",
        "ecs:UpdateService"
      ],
      "Resource": "${ecs_service_arn}",
      "Condition": {
        "ArnLikeIfExists": {
          "ecs:task-definition": "${task_definition_family_arn}"
        },
        "StringEqualsIfExists": {
          "ecs:enable-execute-command": "false"
        }
      }
    },
    {
      "Sid": "EcsListTasksInOneCluster",
      "Effect": "Allow",
      "Action": "ecs:ListTasks",
      "Resource": "*",
      "Condition": {
        "ArnEquals": {
          "ecs:cluster": "${ecs_cluster_arn}"
        }
      }
    },
    {
      "Sid": "EcsDescribeTasksInOneCluster",
      "Effect": "Allow",
      "Action": "ecs:DescribeTasks",
      "Resource": "${ecs_task_arn}"
    },
    {
      "Sid": "PassOnlyTheExecutionRoleToEcs",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "${execution_role_arn}",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    }
  ]
}
