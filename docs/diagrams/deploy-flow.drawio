        <mxCell id="legend-denied" style="endArrow=cross;endFill=1;html=1;strokeWidth=2;strokeColor=#D13212;endSize=8;dashed=1;dashPattern=8 6;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1640" y="803" as="sourcePoint" /><mxPoint x="1710" y="803" as="targetPoint" /></mxGeometry></mxCell>
