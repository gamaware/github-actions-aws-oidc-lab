        <mxCell id="trust-note" value="&lt;b&gt;Deploy role trust policy&lt;/b&gt;&lt;br&gt;aud = sts.amazonaws.com&lt;br&gt;GitHub sub = repo:OWNER/REPO:environment:production&lt;br&gt;GitLab sub = project_path:GROUP/PROJECT:ref_type:branch:ref:main&lt;br&gt;Every other subject, including pull requests, is refused." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=light-dark(#FFFFFF,#1E2A33);strokeColor=#DD344C;dashed=0;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="720" y="870" width="460" height="110" as="geometry" /></mxCell>
