        <mxCell id="step-3-desc-legend" value="&lt;div&gt;&lt;b&gt;Manual approval&lt;/b&gt;&lt;/div&gt;&lt;div&gt;The Approve stage shows the digest; a person with codepipeline:PutApprovalResult approves it before anything reaches ECS.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontColor=light-dark(#000000,#FFFFFF);fontFamily=Helvetica;" vertex="1" parent="step-3-legend"><mxGeometry x="52" y="0" width="468" height="90" as="geometry" /></mxCell>
