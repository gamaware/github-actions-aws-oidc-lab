{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitLabCiOidc",
      "Effect": "Allow",
      "Principal": {
        "Federated": "${oidc_provider_arn}"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "${issuer_host}:aud": "sts.amazonaws.com",
          "${issuer_host}:sub": ${jsonencode(subjects)}
        }
      }
    }
  ]
}
